# Public https address of the site. API, MCP and OAuth live under it (/api, /mcp, /authorize ...).
PUBLIC_URL=https://autointeriore.ge
# Where the website/admin is served from (CORS + links in approval messages)
WEB_ORIGIN=https://autointeriore.ge
ADMIN_URL=https://autointeriore.ge/#/admin

# PostgreSQL. Leave empty to run on embedded PGlite in DATA_DIR (single small instance / demo).
DATABASE_URL=postgres://autointeriore:change-me@db:5432/autointeriore
DATA_DIR=/data

# First owner account, created once on an empty database
ADMIN_EMAIL=owner@autointeriore.ge
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=Owner

# Load the pitch data set into an empty database (default: off in production)
SEED_DEMO=false

# Optional: purchase orders by email
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Auto Interiore <workshop@autointeriore.ge>

# Optional: Metricool scheduling (without it, "schedule" returns the request instead of sending it)
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
