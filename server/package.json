{
  "name": "autointeriore-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend, admin API and MCP server for Auto Interiore",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
